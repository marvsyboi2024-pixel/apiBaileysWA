# ===================================
# Server Configuration
# ===================================
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=debug

# ===================================
# Authentication
# ===================================
# Simple auth mode: single global token
# Leave empty to disable simple auth (use Redis API keys instead)
# Supported token headers for API requests:
# - Authorization: Bearer <token>
# - x-api-key: <token>
# - x-access-token: <token>
# - token: <token>
AUTH_GLOBAL_TOKEN=your-secret-token-here

# ===================================
# Redis Configuration (Optional)
# ===================================
# Set to true to enable Redis for auth state, API keys, and broadcast queue
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# ===================================
# Baileys Configuration
# ===================================
BAILEYS_LOG_LEVEL=warn
# Use 'default' to auto-fetch latest version
BAILEYS_CLIENT_VERSION=default
# Maximum retry attempts to reconnect (-1 for infinite)
MAX_RETRIES=5
# Delay in ms between reconnection attempts
RECONNECT_INTERVAL=5000
# Maximum concurrent WhatsApp sessions
MAX_SESSIONS=50

# ===================================
# Message Filtering
# ===================================
IGNORE_GROUP_MESSAGES=false
IGNORE_STATUS_MESSAGES=true
IGNORE_BROADCAST_MESSAGES=true
IGNORE_NEWSLETTER_MESSAGES=true
IGNORE_BOT_MESSAGES=true
IGNORE_META_AI_MESSAGES=true

# ===================================
# Auto Reply Configuration
# ===================================
AUTO_REPLY_ENABLED=true
# Always wrap values in double quotes ("text").
# Line Breaks: Use \n for new lines.
# Escaping with backslash: \" for double quotes.
AUTO_REPLY_MESSAGE="Hello, we're currently away.\nWe'll reply to your message soon."
# always, time_range, on_webhook_fail
AUTO_REPLY_TYPE=on_webhook_fail
AUTO_REPLY_TIME_START=18:00
AUTO_REPLY_TIME_END=08:00

# ===================================
# Webhook Configuration
# ===================================
# Global default webhook URL (can be overridden per session)
# Outbound webhook authentication fallback order:
#   per-session webhook secret -> AUTH_GLOBAL_TOKEN (only when fallback is enabled)
WEBHOOK_URL=
# Allow AUTH_GLOBAL_TOKEN as fallback webhook secret when session secret is empty.
# Default behavior in code:
# - development: true
# - production : false
# Set explicitly to avoid ambiguity.
# WARNING: enabling this in production may expose AUTH_GLOBAL_TOKEN to third-party webhook receivers.
WEBHOOK_ALLOW_GLOBAL_TOKEN_FALLBACK=true
# Comma-separated list of allowed events, or 'ALL'
# Available: MESSAGES_UPSERT, MESSAGES_UPDATE, MESSAGES_DELETE, MESSAGES_REACTION,
#            CONNECTION_UPDATE, CHATS_UPSERT, CHATS_UPDATE, CHATS_DELETE,
#            CONTACTS_UPSERT, CONTACTS_UPDATE, GROUPS_UPSERT, GROUPS_UPDATE,
#            GROUP_PARTICIPANTS_UPDATE, PRESENCE_UPDATE, LABELS_EDIT, LABELS_ASSOCIATION,
#            BLOCKLIST_SET, BLOCKLIST_UPDATE, QRCODE_UPDATED, etc.
WEBHOOK_ALLOWED_EVENTS=ALL
# Retry policy for webhook delivery
WEBHOOK_RETRY_MAX=3
WEBHOOK_RETRY_INTERVAL=5000
WEBHOOK_BACKOFF_FACTOR=3
# Smart retry by HTTP status (default on):
# - 4xx (except 408/425/429): not retried — retrying a bad request never helps.
# - 429 / 503: when the response carries a Retry-After header it is honored
#   (capped at 5 min) instead of the fixed backoff.
# - 5xx / 408 / 425: retried with exponential backoff as before.
# Set WEBHOOK_RETRY_HTTP_429=false to ignore Retry-After and always use backoff.
WEBHOOK_RETRY_HTTP_429=true
# Optional override of the retryable status set (comma-separated).
# Default: 408,425,429,500,502,503,504
# WEBHOOK_RETRYABLE_STATUSES=408,425,429,500,502,503,504
# Signature mode for outbound webhooks:
# - off      : no signature headers
# - optional : include signature headers when a secret is available
# - required : fail send when no secret is available
WEBHOOK_SIGNATURE_MODE=off
# Max concurrent outbound webhook requests globally
WEBHOOK_CONCURRENCY=20

# ===================================
# Broadcast / Bulk Message Configuration
# ===================================
# Minimum delay between individual messages (ms)
BROADCAST_MIN_DELAY_MS=1500
# Maximum delay between individual messages (ms)
BROADCAST_MAX_DELAY_MS=3000
# Number of messages to send before a batch pause
BROADCAST_BATCH_SIZE=10
# Pause duration between batches (ms)
BROADCAST_BATCH_PAUSE_MS=5000
# Show a "composing…" typing bubble per recipient during broadcasts.
# Default: false — safer & less bot-like (typing bubbles to strangers are odd).
# NOTE: when true, each recipient ALSO incurs the typing delay from
# SIMULATE_TYPING_DELAY_* on top of BROADCAST_MIN/MAX_DELAY_MS.
BROADCAST_TYPING_SIMULATION=false
# Delay distribution between broadcast messages:
# - uniform : constant random between MIN/MAX (legacy)
# - human   : mix of short gaps, occasional longer pauses + jitter (WA-like)
BROADCAST_DELAY_DISTRIBUTION=uniform
# Check recipient WA-registration in batches instead of 1-by-1.
# Fewer usync queries to WA servers = smaller footprint & faster jobs.
# true  → batch via CHECK_WA_BATCH_SIZE
# false → 1-by-1 (legacy)
BROADCAST_BATCH_CHECK_WA=false
# Batch size for BROADCAST_BATCH_CHECK_WA=true
BROADCAST_CHECK_WA_BATCH_SIZE=50

# ===================================
# Media Configuration
# ===================================
# Include media as base64 in webhook payloads
MEDIA_INCLUDE_BASE64=false
# Enable automatic cleanup of old media files
MEDIA_CLEANUP_ENABLED=true
# Cleanup interval (ms) - default 1 hour
MEDIA_CLEANUP_INTERVAL_MS=3600000
# Max age of media files (hours)
MEDIA_MAX_AGE_HOURS=24

# ===================================
# CORS Configuration
# ===================================
# Allowed origins for cross-origin requests.
# Use '*' to allow all origins (default, acceptable for API-only servers).
# For multiple domains, use comma-separated values:
# CORS_ORIGIN=https://app1.example.com,https://app2.example.com,https://admin.example.com
# Note: CORS only affects browser requests. Webhooks and server-to-server
# calls are NOT affected by CORS settings.
CORS_ORIGIN=*

# ===================================
# Proxy / Network Configuration
# ===================================
# Trust proxy headers (x-forwarded-for / x-real-ip / cf-connecting-ip) for
# client IP detection (rate limiting / auth).
# - false (default): use socket remote address. Safe when exposed directly.
# - true: trust proxy headers. Enable ONLY behind a trusted reverse proxy /
#   load balancer (e.g. Nginx, Caddy, Cloudflare, AWS ALB). If enabled while
#   directly exposed, clients can spoof these headers to bypass rate limits.
TRUST_PROXY=false

# ===================================
# Dashboard Configuration
# ===================================
# Enable/disable the web dashboard (default: true)
DASHBOARD_ENABLED=true
# Allow new user registration (default: false)
# First user can always register (admin setup)
DASHBOARD_REGISTRATION_ENABLED=false
# Require admin approval for newly registered users before first login.
# false = users become active immediately after registration.
# true  = users are created with pending status until approved by an admin.
DASHBOARD_REGISTRATION_REQUIRE_APPROVAL=true
# JWT secret for dashboard sessions.
# ⚠️ REQUIRED in production: if unset or still the default, dashboard auth is
#   DISABLED (fail-closed, returns 503) rather than signing tokens with a
#   publicly-known default secret. Generate: openssl rand -base64 48
DASHBOARD_JWT_SECRET=change-this-to-a-random-secret
# Single minimum password length for all environments.
# Keep it simple and consistent (recommended >= 6).
DASHBOARD_PASSWORD_MIN_LENGTH=6

# ===================================
# WA Web Behavior Simulation
# ===================================
# Auto-send "composing" presence before each message (default: true)
SIMULATE_TYPING_BEFORE_SEND=true
# Typing delay range in ms (random between min-max)
SIMULATE_TYPING_DELAY_MIN_MS=1500
SIMULATE_TYPING_DELAY_MAX_MS=3000
# ---------------------------------------------------------------------------
# AUTO_READ_MESSAGES — RISK WARNING
# ---------------------------------------------------------------------------
# When enabled, EVERY incoming message is marked read automatically.
# A real human does NOT open & read 100% of chats instantly, 24/7.
# Instant 0ms read receipts on every message is a well-known bot signature
# and can contribute to account bans. Leave OFF unless you truly need it.
# If you DO enable it, also set AUTO_READ_DELAY_ENABLED=true below so reads
# happen after a natural "opened chat" delay instead of instantly.
# (default: false, like the WA Web "read receipts" toggle)
AUTO_READ_MESSAGES=false
# Simulate a natural "opened chat" delay before marking messages as read
# (only applies when AUTO_READ_MESSAGES=true). Without this, reads fire
# instantly at 0ms — bot-like. Recommended: keep enabled.
# true  → random delay in [AUTO_READ_DELAY_MIN_MS, AUTO_READ_DELAY_MAX_MS]
# false → read instantly (legacy behavior)
AUTO_READ_DELAY_ENABLED=true
# Random "opened chat" delay range (ms) before a read receipt is sent.
# Human-like range, NOT milliseconds-instant.
AUTO_READ_DELAY_MIN_MS=1500
AUTO_READ_DELAY_MAX_MS=4000
# Auto-set presence to "available" when sending messages (default: true)
AUTO_MARK_ONLINE=true
# Auto-reject incoming calls
REJECT_CALLS=false
# Automatically reject incoming calls to prevent numbers from getting banned (default: false)
REJECT_CALLS=false

# ===================================
# Humanized Interaction (WA-Web-like pacing)
# ===================================
# All knobs below default to the LEGACY behavior (everything instant/off)
# so existing deployments are unaffected until you opt in.
#
# Mark an incoming message as read before auto-replying to it (1-on-1 chats
# only). Reproduces "open chat → read → type" instead of replying with no
# prior read receipt (bot-like). Requires a natural read delay:
#   true  → wait HUMANIZE_READ_* range, mark read, then compose & send
#   false → send reply without an explicit read step (legacy)
HUMANIZE_READ_BEFORE_REPLY=true
# Random "reading" delay range (ms) before the read receipt is sent.
# Scales with incoming message length when enabled.
HUMANIZE_READ_DELAY_MIN_MS=800
HUMANIZE_READ_DELAY_MAX_MS=2500
# Random "thinking" gap (ms) before typing starts (after read).
# 0/0 → no thinking gap (legacy)
HUMANIZE_THINK_MIN_MS=800
HUMANIZE_THINK_MAX_MS=2000
# Typing ("composing") duration becomes proportional to reply length when
# enabled, instead of a fixed random range. (ms bounds still apply)
# Default false = legacy fixed random typing delay (SIMULATE_TYPING_DELAY_*)
HUMANIZE_TYPING_PROPORTIONAL=false
# Min gap between repeated composing/paused to the SAME chat (ms).
# 0 → send presence every time (legacy). Helps avoid rapid toggling.
HUMANIZE_PRESENCE_DEDUPE_MS=0
# Global pacing: min/max random gap between ANY outbound actions within a
# session (across chats). Prevents bursts when many messages/requests arrive
# at once. 0/0 → no global pacing (legacy)
HUMANIZE_GLOBAL_PACING_MIN_MS=0
HUMANIZE_GLOBAL_PACING_MAX_MS=0
# Delay pattern for humanize read/think gaps.
# uniform = random min-max (legacy).
# human   = short gaps most of the time with occasional longer pauses
#           (same distribution as BROADCAST_DELAY_DISTRIBUTION=human).
HUMANIZE_DELAY_DISTRIBUTION=uniform
