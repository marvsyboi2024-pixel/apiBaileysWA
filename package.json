{
	"name": "api-baileys-wa-hono",
	"version": "1.5.0",
	"description": "WhatsApp REST API powered by Baileys WA Sockets with multi-session support, Dual-Runtime support, Redis integration, and broadcast queuing.",
	"author": "indrafer",
	"license": "MIT",
	"module": "src/index.ts",
	"scripts": {
		"dev": "bun --watch src/index.ts",
		"start": "bun src/index.ts",
		"dev:node": "tsx watch src/index.ts",
		"start:node": "tsx src/index.ts",
		"build-check": "bunx tsc --noEmit",
		"lint": "bunx @biomejs/biome check src/ --diagnostic-level=error",
		"lint:all": "bunx @biomejs/biome check src/",
		"format": "bunx @biomejs/biome check --write src/",
		"manage-api-keys": "LOG_LEVEL=warn bun scripts/manage-api-keys.ts",
		"manage-api-keys:node": "LOG_LEVEL=warn tsx scripts/manage-api-keys.ts"
	},
	"dependencies": {
		"@hapi/boom": "^10.0.1",
		"@hono/node-server": "^1.19.12",
		"@hono/swagger-ui": "^0.6.1",
		"@hono/zod-openapi": "^1.2.4",
		"@whiskeysockets/baileys": "^7.0.0-rc14",
		"axios": "^1.20.0",
		"baileys-antiban": "^4.10.0",
		"bcryptjs": "^3.0.3",
		"chalk": "^4.1.2",
		"dotenv": "^18.0.5",
		"hono": "^4.12.9",
		"lru-cache": "^11.2.7",
		"mongodb": "^6.21.0",
		"node-cache": "^5.1.2",
		"node-fetch": "^3.3.2",
		"node-telegram-bot-api": "^0.66.0",
		"pino": "^10.4.0",
		"pino-pretty": "^13.1.3",
		"qrcode": "^1.5.4",
		"redis": "^5.11.0",
		"sharp": "^0.34.5",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.10",
		"@types/qrcode": "^1.5.6",
		"bun-types": "latest",
		"tsx": "^4.21.0"
	},
	"main": "antibill.js",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/marvsyboi2024-pixel/apiBaileysWA.git"
	},
	"keywords": [],
	"type": "commonjs",
	"bugs": {
		"url": "https://github.com/marvsyboi2024-pixel/apiBaileysWA/issues"
	},
	"homepage": "https://github.com/marvsyboi2024-pixel/apiBaileysWA#readme"
}
